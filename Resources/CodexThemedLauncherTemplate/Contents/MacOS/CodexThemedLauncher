#!/bin/zsh
# Codex Studio DockDoor launcher
#
# DockDoor identifies the running helper app rather than the official Codex
# bundle that the theme engine launches. Keeping this helper alive preserves a
# themed DockDoor pin and gives a newly updated stock Codex process a chance to
# be restarted with the verified loopback theme endpoint.
set -u

home="${HOME:-}"
if [ -z "$home" ]; then
  print -u2 "Codex Studio launcher could not resolve the user's home directory."
  exit 1
fi

runtime_root="${CODEX_STUDIO_RUNTIME_ROOT:-$home/.codex/codex-dream-skin-studio}"
engine="${CODEX_STUDIO_ENGINE_PATH:-$runtime_root/scripts/start-dream-skin-macos.sh}"
state_root="${CODEX_STUDIO_STATE_ROOT:-$home/Library/Application Support/CodexDreamSkinStudio}"
log_file="$state_root/dock-launch.log"
engine_lock="$state_root/theme-engine.lock"
state_file="$state_root/state.json"
persistence_file="$state_root/theme-persistence.plist"
persistence_script="$runtime_root/scripts/set-theme-persistence-macos.sh"

/bin/mkdir -p "$state_root"
if [ ! -x "$engine" ]; then
  print -u2 "Codex Studio theme runtime is missing: $engine"
  exit 1
fi

port="${CODEX_STUDIO_CDP_PORT:-}"
if [ -z "$port" ] && [ -f "$state_root/theme-persistence.plist" ]; then
  port="$(/usr/bin/plutil -extract port raw -o - "$state_root/theme-persistence.plist" 2>/dev/null || true)"
fi
case "$port" in
  ''|*[!0-9]*) port=9341 ;;
esac

cdp_url="http://127.0.0.1:${port}/json/version"
codex_executable=""

log_line() {
  print -r -- "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ') $*" >>"$log_file"
}

refresh_port() {
  local saved_port
  [ -f "$state_file" ] || return 0
  saved_port="$(/usr/bin/plutil -extract port raw -o - "$state_file" 2>/dev/null || true)"
  case "$saved_port" in
    ''|*[!0-9]*) return 0 ;;
  esac
  [ "$saved_port" -ge 1024 ] && [ "$saved_port" -le 65535 ] || return 0
  if [ "$saved_port" != "$port" ]; then
    port="$saved_port"
    cdp_url="http://127.0.0.1:${port}/json/version"
    log_line "Following the theme engine to verified port $port."
  fi
}

ensure_theme_persistence() {
  [ -x "$persistence_script" ] || return 0

  local enabled=""
  local session=""
  local theme_id=""
  local monitor_domain="gui/$(/usr/bin/id -u)"
  enabled="$(/usr/bin/plutil -extract enabled raw -o - "$persistence_file" 2>/dev/null || true)"
  if [ "$enabled" = "true" ] && /bin/launchctl print "$monitor_domain/com.codexthemes.theme-monitor" >/dev/null 2>&1; then
    return 0
  fi

  # Older 0.1.x installations could apply a theme before the persistence
  # agent existed. The helper is the one place we can repair that state even
  # when DockDoor is launching the helper directly instead of Studio.
  session="$(/usr/bin/plutil -extract session raw -o - "$state_file" 2>/dev/null || true)"
  [ "$session" = "active" ] || return 0
  theme_id="$(/usr/bin/plutil -extract appliedThemeId raw -o - "$state_file" 2>/dev/null || true)"
  case "$theme_id" in
    ''|*[!A-Za-z0-9._-]*) return 0 ;;
  esac
  [ -f "$state_root/theme/theme.json" ] || return 0

  log_line "Repairing the missing Codex theme persistence monitor for $theme_id."
  if ! "$persistence_script" --enabled true --port "$port" --theme-id "$theme_id" >>"$log_file" 2>&1; then
    log_line "Could not repair the Codex theme persistence monitor."
  fi
}

discover_codex_executable() {
  local candidate identifier executable_name configured
  configured="${CODEX_APP_BUNDLE:-}"
  for candidate in "$configured" \
    "/Applications/ChatGPT.app" "$home/Applications/ChatGPT.app" \
    "/Applications/Codex.app" "$home/Applications/Codex.app"; do
    [ -n "$candidate" ] || continue
    [ -f "$candidate/Contents/Info.plist" ] || continue
    identifier="$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$candidate/Contents/Info.plist" 2>/dev/null || true)"
    [ "$identifier" = "com.openai.codex" ] || continue
    executable_name="$(/usr/bin/plutil -extract CFBundleExecutable raw -o - "$candidate/Contents/Info.plist" 2>/dev/null || true)"
    if [ -x "$candidate/Contents/MacOS/$executable_name" ]; then
      codex_executable="$candidate/Contents/MacOS/$executable_name"
      return 0
    fi
  done

  candidate="$(/usr/bin/mdfind 'kMDItemCFBundleIdentifier == "com.openai.codex"' | /usr/bin/head -n 1)"
  if [ -f "$candidate/Contents/Info.plist" ]; then
    identifier="$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$candidate/Contents/Info.plist" 2>/dev/null || true)"
    executable_name="$(/usr/bin/plutil -extract CFBundleExecutable raw -o - "$candidate/Contents/Info.plist" 2>/dev/null || true)"
    if [ "$identifier" = "com.openai.codex" ] && [ -x "$candidate/Contents/MacOS/$executable_name" ]; then
      codex_executable="$candidate/Contents/MacOS/$executable_name"
      return 0
    fi
  fi
  return 1
}

find_codex_pid() {
  [ -n "$codex_executable" ] || discover_codex_executable || true
  [ -n "$codex_executable" ] || return 0
  while read -r pid command_line; do
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    case "$command_line" in
      "$codex_executable"|"$codex_executable "*)
        print -r -- "$pid"
        return 0
        ;;
    esac
  done < <(/bin/ps -axo pid=,command=)
}

cdp_ready() {
  /usr/bin/curl --noproxy '*' --silent --show-error --fail --max-time 1 "$cdp_url" >/dev/null 2>&1
}

theme_state_ready() {
  local session active_id expected_id recorded_pid current_pid
  [ -f "$state_file" ] || return 1
  [ -f "$state_root/theme/theme.json" ] || return 1
  session="$(/usr/bin/plutil -extract session raw -o - "$state_file" 2>/dev/null || true)"
  active_id="$(/usr/bin/plutil -extract appliedThemeId raw -o - "$state_file" 2>/dev/null || true)"
  expected_id="$(/usr/bin/plutil -extract id raw -o - "$state_root/theme/theme.json" 2>/dev/null || true)"
  recorded_pid="$(/usr/bin/plutil -extract codexPid raw -o - "$state_file" 2>/dev/null || true)"
  current_pid="$(find_codex_pid)"
  [ "$session" = "active" ]
  [ -n "$active_id" ] && [ "$active_id" = "$expected_id" ]
  [ -n "$recorded_pid" ] && [ "$recorded_pid" = "$current_pid" ]
}

themed_runtime_ready() {
  refresh_port
  cdp_ready || return 1
  theme_state_ready
}

wait_for_themed_runtime() {
  local wait_seconds="${1:-20}"
  local deadline=$((SECONDS + wait_seconds))
  while [ "$SECONDS" -lt "$deadline" ]; do
    themed_runtime_ready && return 0
    /bin/sleep 0.35
  done
  return 1
}

run_engine() {
  local engine_status=0
  local lock_held="false"
  while ! /usr/bin/shlock -p "$$" -f "$engine_lock"; do
    refresh_port
    themed_runtime_ready && return 0
    /bin/sleep 1
  done
  lock_held="true"

  log_line "Starting the Codex Studio theme engine on port $port."
  /usr/bin/arch -arm64 /bin/bash "$engine" --port "$port" --restart-existing \
    >>"$log_file" 2>&1 || engine_status=$?

  if [ "$lock_held" = "true" ]; then
    /bin/rm -f "$engine_lock"
  fi
  refresh_port
  return "$engine_status"
}

start_engine_with_retries() {
  local attempt=1
  local backoff=1
  local engine_status=0
  while [ "$attempt" -le 3 ]; do
    if themed_runtime_ready; then
      log_line "Verified the existing themed Codex runtime; no restart was needed."
      return 0
    fi

    log_line "Theme runtime verification attempt $attempt of 3."
    engine_status=0
    run_engine || engine_status=$?
    refresh_port
    if [ "$engine_status" -eq 0 ] && wait_for_themed_runtime 20; then
      log_line "Verified the themed Codex runtime on attempt $attempt."
      return 0
    fi

    log_line "Theme runtime verification attempt $attempt failed (status $engine_status)."
    if [ "$attempt" -lt 3 ]; then
      /bin/sleep "$backoff"
      backoff=$((backoff * 2))
    fi
    attempt=$((attempt + 1))
  done
  return 1
}

refresh_port
ensure_theme_persistence
engine_status=0
if ! start_engine_with_retries; then
  log_line "The Codex Studio theme engine failed its bounded verification loop."
  exit 1
fi

# A successful engine run leaves the official app running with the active
# theme. Stay alive until that app exits so DockDoor continues to track this
# launcher instead of normalizing the pin to ChatGPT.app.
while true; do
  refresh_port
  codex_pid="$(find_codex_pid)"
  if [ -z "$codex_pid" ]; then
    exit 0
  fi

  if themed_runtime_ready; then
    /bin/sleep 2
    continue
  fi

  # Give a newly spawned renderer a short startup window. If the official
  # updater launched it without the debug endpoint, restart it through the
  # same verified engine path used by Apply to Codex.
  /bin/sleep 2
  [ -n "$(find_codex_pid)" ] || exit 0
  if themed_runtime_ready; then
    continue
  fi

  log_line "Codex pid $codex_pid is not verified as themed; repairing the launch."
  if ! start_engine_with_retries; then
    log_line "The Codex Studio repair failed its bounded verification loop."
    exit 1
  fi
done
